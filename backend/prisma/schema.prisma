generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Asset {
  id             Int             @id @default(autoincrement())
  name           String
  type           String
  latitude       Float
  longitude      Float
  status         String
  village        String
  sensorReadings SensorReading[]
  alerts         Alert[]
}

model Complaint {
  id          Int      @id @default(autoincrement())
  title       String
  category    String
  description String
  latitude    Float?
  longitude   Float?
  status      String   @default("Pending")
  createdAt   DateTime @default(now())
}

model SensorReading {
  id         Int      @id @default(autoincrement())
  assetId    Int
  waterLevel Float
  flowRate   Float
  pressure   Float
  recordedAt DateTime @default(now())
  asset      Asset    @relation(fields: [assetId], references: [id])
}

model Alert {
  id        Int      @id @default(autoincrement())
  assetId   Int
  message   String
  severity  String
  status    String   @default("Open")
  createdAt DateTime @default(now())
  asset     Asset    @relation(fields: [assetId], references: [id])
}